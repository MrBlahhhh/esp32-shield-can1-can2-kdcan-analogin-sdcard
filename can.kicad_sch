  (symbol (lib_id "Device:R") (at 49.53 138.43 180) (unit 1)
    (in_bom yes) (on_board yes) (dnp no)
    (uuid 70567b87-19df-5456-905a-49a426621066)
    (property "Reference" "R33" (at 49.53 127.54 0)
      (effects (font (size 1.27 1.27)) )
    )
    (property "Value" "33" (at 49.53 149.32 0)
