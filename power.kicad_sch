    (in_bom yes) (on_board yes) (dnp no)
    (uuid cfa8eabc-d983-5ccf-ab34-8ce915fd4a8f)
    (property "Reference" "R3" (at 36.83 254.54 270)
      (effects (font (size 1.27 1.27)) )
    )
    (property "Value" "100" (at 36.83 258.54 270)
      (effects (font (size 1.27 1.27)) )
    )
    (property "Footprint" "Resistor_SMD:R_1206_3216Metric" (at 36.83 258.54 270)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Datasheet" "~" (at 36.83 258.54 270)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "Inrush limit, and the value is set by the resistor's own rating rather than by the charge time. Charging 0.5 F to 4.7 V dissipates 0.5*C*V^2 = 5.5 J in here whatever the resistance is; what changes is how fast. At 22 ohm the first instant is V^2/R = 1.0 W into a 1206 rated 0.25 W, and a 1206's thermal time constant is far shorter than the 11 s the pulse would last -- it would cook. 100 ohm makes the peak 0.22 W, inside the rating, at the cost of a 50 s time constant: the hold-up is not fully armed for the first few minutes of a drive. A 2010 would buy back the speed if that ever matters" (at 36.83 258.54 270)
      (effects (font (size 1.27 1.27)) hide)
    )
    (pin "1" (uuid 67beeb12-bd9e-5c4a-a7f9-03c185101c13))
    (pin "2" (uuid 0a09fb7f-f1bf-53b2-87c2-ccc5689fab53))
