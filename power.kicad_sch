    (property "Reference" "U1" (at 110.49 26.67 0)
      (effects (font (size 1.27 1.27)) )
    )
    (property "Value" "TLV431A" (at 110.49 46.48 0)
      (effects (font (size 1.27 1.27)) )
    )
    (property "Footprint" "Package_TO_SOT_SMD:SOT-23" (at 110.49 46.48 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Datasheet" "~" (at 110.49 46.48 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "MPN" "TLV431ASN1T1G" (at 110.49 46.48 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "Power-fail comparator. Below the trip point it stops conducting and R_pu takes PWR_FAIL high, so the interrupt is a rising edge and an absent or dead part reads as 'failing' rather than as 'fine'. PINOUT: this uses KiCad's TL431DBZ numbering (1 K, 2 REF, 3 A) on a plain SOT-23. Shunt references are NOT consistent between vendors in this package -- CONFIRM against the datasheet for the exact part ordered. If REF and A are swapped the part simply never conducts and PWR_FAIL sits permanently asserted: loud, harmless, and obvious on the bench, but it will not be caught by ERC or DRC" (at 110.49 46.48 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (pin "3" (uuid 9661d6c0-6a78-5968-ae83-1ca65fea85eb))
