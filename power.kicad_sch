    (property "MPN" "Bourns MF-MSMF020/60-2" (at 36.83 56.61 270)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "OBD-II pin 16 is PERMANENT battery -- live with the ignition off and the car parked -- so the thing being protected against is this board failing short across it, which without protection is a fire. A resettable PTC rather than a fuse: same job, and it is the same part as PF2 so it costs no extra BOM line. 60 V rated, which covers the 42 V the TVS beside it clamps to. Load is at most 16 mA through the optional pull-up against a 200 mA hold" (at 36.83 56.61 270)
      (effects (font (size 1.27 1.27)) hide)
    )
