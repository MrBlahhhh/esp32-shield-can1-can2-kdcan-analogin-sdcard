    (property "Value" "RANGE3 (default 0-5V)" (at 87.63 239.52 0)
      (effects (font (size 1.27 1.27)) )
    )
    (property "Footprint" "Jumper:SolderJumper-3_P1.3mm_Bridged12_Pad1.0x1.5mm" (at 87.63 239.52 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Datasheet" "~" (at 87.63 239.52 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "Ships BRIDGED 1-2 = the 0-5V range, which is what almost every automotive sensor is. Cut 1-2 and bridge 2-3 for 0-16V; cut 1-2 and leave both open for no divider (then close BYPASS3 for a raw 0-3.3V sensor). Defaulting to 0-5V also means the firmware's DIVIDER_GAIN matches the board as shipped. NOTE: moving a channel off the default breaks the match with the return attenuator, so that channel loses its ground rejection -- read it single-ended if you do" (at 87.63 239.52 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (pin "1" (uuid b5a0d965-7cd7-52e9-9017-f954d19aa8fa))
