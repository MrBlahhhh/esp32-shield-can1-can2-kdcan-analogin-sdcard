    (property "Reference" "JP14" (at 214.63 33.02 0)
      (effects (font (size 1.27 1.27)) )
    )
    (property "Value" "RANGE4 (default 0-5V)" (at 214.63 54.1 0)
      (effects (font (size 1.27 1.27)) )
    )
    (property "Footprint" "Jumper:SolderJumper-3_P1.3mm_Bridged12_Pad1.0x1.5mm" (at 214.63 54.1 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Datasheet" "~" (at 214.63 54.1 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "Ships BRIDGED 1-2 = the 0-5V range, which is what almost every automotive sensor is. Cut 1-2 and bridge 2-3 for 0-16V; cut 1-2 and leave both open for no divider (then close BYPASS4 for a raw 0-3.3V sensor). Defaulting to 0-5V also means the firmware's DIVIDER_GAIN matches the board as shipped. NOTE: moving a channel off the default breaks the match with the return attenuator, so that channel loses its ground rejection -- read it single-ended if you do" (at 214.63 54.1 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (pin "1" (uuid 5ce78f9e-a6fb-58f5-9207-f083edc23b19))
