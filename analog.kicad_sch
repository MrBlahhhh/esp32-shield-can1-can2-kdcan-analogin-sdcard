  (symbol (lib_id "Device:C") (at 92.71 237.49 0) (unit 1)
    (in_bom yes) (on_board yes) (dnp no)
    (uuid cc70d83a-aae2-501b-9c83-1f2068014442)
    (property "Reference" "C28" (at 93.98 236.22 0)
      (effects (font (size 1.27 1.27)) (justify left) )
    )
    (property "Value" "470nF" (at 93.98 239.27 0)
      (effects (font (size 1.27 1.27)) (justify left) )
    )
    (property "Footprint" "Capacitor_SMD:C_0805_2012Metric" (at 93.98 239.27 0)
      (effects (font (size 1.27 1.27)) (justify left) hide)
    )
    (property "Datasheet" "~" (at 93.98 239.27 0)
      (effects (font (size 1.27 1.27)) (justify left) hide)
    )
    (property "Voltage" "50V" (at 93.98 239.27 0)
      (effects (font (size 1.27 1.27)) (justify left) hide)
    )
    (property "Note" "Ch4 anti-alias. 470nF, not the 100nF this inherited: source impedance here is (1k+10k)||2.21k = 1.84k, so 100nF puts the corner at 865 Hz -- above the 430 Hz Nyquist of the ADS1115 at 860 SPS, and well above anything the ESP32's own SAR ADC can sample cleanly. That was survivable while 0-5 V was the default range (261 Hz) and became the only behaviour when the range jumpers went. 470nF gives 184 Hz, which still passes anything a wideband does and stops engine noise folding into the log" (at 93.98 239.27 0)
      (effects (font (size 1.27 1.27)) (justify left) hide)
    )
    (pin "1" (uuid 9110bcb1-34aa-590f-b6ce-6633746fbafb))
    (pin "2" (uuid 06c84c8d-d9ec-53ce-bddf-f3c07402b495))
