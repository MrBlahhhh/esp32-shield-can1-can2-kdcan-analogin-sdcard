  (symbol (lib_id "Device:C") (at 92.71 185.42 0) (unit 1)
    (in_bom yes) (on_board yes) (dnp no)
    (uuid 14c2f276-7326-5b2f-a40f-09fb467a291f)
    (property "Reference" "C27" (at 93.98 184.15 0)
      (effects (font (size 1.27 1.27)) (justify left) )
    )
    (property "Value" "470nF" (at 93.98 187.2 0)
      (effects (font (size 1.27 1.27)) (justify left) )
    )
    (property "Footprint" "Capacitor_SMD:C_0805_2012Metric" (at 93.98 187.2 0)
      (effects (font (size 1.27 1.27)) (justify left) hide)
    )
    (property "Datasheet" "~" (at 93.98 187.2 0)
      (effects (font (size 1.27 1.27)) (justify left) hide)
    )
    (property "Voltage" "50V" (at 93.98 187.2 0)
      (effects (font (size 1.27 1.27)) (justify left) hide)
    )
    (property "Note" "Ch3 anti-alias. 470nF, not the 100nF this inherited: source impedance here is (1k+10k)||2.21k = 1.84k, so 100nF puts the corner at 865 Hz -- above the 430 Hz Nyquist of the ADS1115 at 860 SPS, and well above anything the ESP32's own SAR ADC can sample cleanly. That was survivable while 0-5 V was the default range (261 Hz) and became the only behaviour when the range jumpers went. 470nF gives 184 Hz, which still passes anything a wideband does and stops engine noise folding into the log" (at 93.98 187.2 0)
      (effects (font (size 1.27 1.27)) (justify left) hide)
    )
    (pin "1" (uuid 7665a35a-6563-5e4e-9920-4e17c8057616))
    (pin "2" (uuid 2d2460eb-2d7a-5668-883c-c57a0dbf086a))
