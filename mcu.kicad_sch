    (property "MPN" "ESP32-S3-DevKitC-1 J1" (at 43.18 73.12 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "Mirrors DevKitC-1 J1. Pins 1-2 (3V3) and 21 (5V) are both INPUTS to the shield. Analog on 4-7 and 12, CAN on 9-11, SD bus on 15-20 -- grouped so each block routes away from the row rather than across it. Pin 3 is RST, pins 13/14 are IO3/IO46, all left open." (at 43.18 73.12 0)
      (effects (font (size 1.27 1.27)) hide)
    )
