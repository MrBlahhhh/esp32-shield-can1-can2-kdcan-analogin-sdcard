    (property "MPN" "ESP32-S3-DevKitC-1 J3" (at 43.18 149.32 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "Mirrors DevKitC-1 J3. K-line on 6/7, I2C on 9/17, WS2812 on 16, and the SD card's two DC control lines on 8/18 -- the only nets that cross to the other side of the board, and they go round the end of the row. Pin 10 (IO38) is left open because it drives the dev board's RGB LED on v1.1; check the revision, some put it on IO48, which is the WS2812 output here." (at 43.18 149.32 0)
      (effects (font (size 1.27 1.27)) hide)
    )
