    (property "MPN" "ESP32-S3-DevKitC-1 J3" (at 43.18 151.86 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "Mirrors DevKitC-1 J3. K-line on 4/5, the second CAN's SPI on 6-9 with its interrupt on 18, WS2812 on 16. Pin 17 is SD_PWR_EN, the one net that crosses to the other side of the board, and it goes round the end of the row. Pin 10 (IO38) is left open because it drives the dev board's RGB LED on v1.1; check the revision, some put it on IO48, which is the WS2812 output here." (at 43.18 151.86 0)
      (effects (font (size 1.27 1.27)) hide)
    )
